# 复制本文件为 .env，然后填写自己的账号信息。
# 注意：.env 已加入 .gitignore，请不要把真实账号密码提交到仓库。

UESTC_PHONE=your_phonenumber
UESTC_PASSWORD=your_password

# 可选配置
# UESTC_HOST=223.5.5.5
# UESTC_WAIT_TIME=10
# UESTC_DEBUG=0

# —— 联网探测 / 稳定性 (V4.1) ——
# 探测地址, 逗号分隔, 格式 url|期望状态码; 留空用内置 generate_204 端点
# UESTC_PROBE_URL=http://connect.rom.miui.com/generate_204|204,http://www.msftconnecttest.com/connecttest.txt|200
# 单个探测请求超时秒数
# UESTC_PROBE_TIMEOUT=5
# 连续探测失败几次才判定掉线(再触发认证)
# UESTC_PROBE_CONFIRM_FAIL=2
# 认证失败指数退避上限秒数
# UESTC_BACKOFF_MAX=300
